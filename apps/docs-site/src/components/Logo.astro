---
/** Original vector identity produced in Claude Design. Originals retain Content Credentials. */
interface Props { wordmark?: boolean }
const { wordmark = false } = Astro.props;
---
<span class:list={["s-logo", wordmark && "s-logo--wordmark"]} aria-hidden="true">
  <img src={wordmark ? "/brand/brandcloud-lockup-horizontal-white.svg" : "/brand/brandcloud-mark-white.svg"} alt="" width={wordmark ? 189 : 32} height={wordmark ? 30 : 32} />
</span>
<style>
  .s-logo { display: inline-flex; align-items: center; flex: none; line-height: 0; }
  .s-logo img { display: block; max-inline-size: 100%; }
  .s-logo--wordmark { inline-size: 11.8125rem; }
</style>
