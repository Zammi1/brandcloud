---
/**
 * The home hero's visual: this site's own brand as the kit builds it. Real buttons, real type and the
 * ratios the tokens build measured (contrast-report.json). Each button goes to its docs.
 */
import Button from "@brandcloud/astro/components/Button.astro";
import { brands } from "@brandcloud/tokens";
import { ratio, fmt } from "../lib/contrast";

const light = brands.docs.light;
const rows = [
  { label: "Depth", props: {}, check: ratio("docs", "light", "action-depth-text", "action-depth-fill@48px"), note: "label on its darkest pixel" },
  { label: "Solid", props: { appearance: "solid" as const }, check: ratio("docs", "light", "accent-text", "accent"), note: "label on fill" },
  { label: "Ink", props: { tone: "ink" as const }, check: ratio("docs", "light", "action-ink-text", "action-ink"), note: "label on fill" },
  { label: "Navy level", props: { tone: "level" as const, level: "navy" as const }, check: ratio("docs", "light", "level-navy-text", "level-navy-highlight"), note: "label on the lighter stop" },
];
const swatches = [
  { name: "Accent", role: "accent", value: light.accent },
  { name: "Ink", role: "text", value: light.text },
  { name: "Paper", role: "canvas", value: light.canvas },
  { name: "Surface", role: "surface-muted", value: light["surface-muted"] },
];
---
<figure class="sp" aria-labelledby="sp-cap">
  <div class="sp__head">
    <p class="sp__type" aria-hidden="true">Aa</p>
    <div>
      <p class="sp__font">Bricolage Grotesque</p>
      <p class="sp__font sp__font--body">Hanken Grotesk for body text</p>
    </div>
  </div>
  <ul class="sp__swatches" aria-label="Brand colours">
    {swatches.map((s) => (
      <li>
        <span class="sp__chip" data-role={s.role} aria-hidden="true"></span>
        <span class="sp__name">{s.name}</span>
        <span class="sp__value s-num">{s.value}</span>
      </li>
    ))}
  </ul>
  <ul class="sp__buttons" aria-label="Buttons and their measured label contrast">
    {rows.map((r) => (
      <li>
        <Button href="/developers/components/#astro-button" size="md" {...r.props}>{r.label}</Button>
        <span class="sp__ratio">
          <strong class="s-num">{fmt(r.check.ratio)}</strong>
          <span>{r.note}, {r.check.pass ? "passes AA" : "fails AA"}</span>
        </span>
      </li>
    ))}
  </ul>
  <figcaption id="sp-cap">This site's own brand, generated from four inputs. The ratios are the ones the tokens build measured.</figcaption>
</figure>

<style>
  .sp {
    margin: 0;
    display: grid;
    gap: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    border: 1px solid var(--brand-border);
    border-radius: var(--brand-radius-panel);
    background: var(--brand-surface);
    box-shadow: var(--brand-shadow-panel);
  }
  .sp__head { display: flex; align-items: center; gap: 1.25rem; padding-block-end: 1.25rem; border-block-end: 1px solid var(--brand-border); }
  .sp__type { font-family: var(--brand-font-display); font-size: 4rem; line-height: 0.9; font-weight: 700; letter-spacing: var(--brand-letter-spacing-tight); }
  .sp__font { font-family: var(--brand-font-display); font-weight: 600; font-size: 1.25rem; line-height: 1.25; }
  .sp__font--body { font-family: var(--brand-font-body); font-weight: 400; font-size: 1rem; color: var(--brand-text-muted); }
  .sp__swatches { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .sp__swatches li { display: grid; gap: 0.2rem; font-size: 0.8125rem; }
  .sp__chip { display: block; block-size: 3rem; border-radius: var(--brand-radius-sm); border: 1px solid var(--brand-border); margin-block-end: 0.35rem; }
  .sp__chip[data-role="accent"] { background: var(--brand-accent); }
  .sp__chip[data-role="text"] { background: var(--brand-text); }
  .sp__chip[data-role="canvas"] { background: var(--brand-canvas); }
  .sp__chip[data-role="surface-muted"] { background: var(--brand-surface-muted); }
  .sp__name { font-weight: 650; }
  .sp__value { color: var(--brand-text-muted); }
  .sp__buttons { display: grid; gap: 0.85rem; margin: 0; padding: 0; list-style: none; }
  .sp__buttons li { display: grid; grid-template-columns: 8.5rem minmax(0, 1fr); gap: 1rem; align-items: center; }
  .sp__buttons li > :global(.ba-button) { justify-content: center; }
  .sp__ratio { display: grid; line-height: 1.3; }
  .sp__ratio strong { font-family: var(--brand-font-display); font-size: 1.125rem; }
  .sp__ratio span { color: var(--brand-text-muted); font-size: 0.875rem; }
  .sp figcaption { color: var(--brand-text-subtle); font-size: 0.875rem; padding-block-start: 1rem; border-block-start: 1px solid var(--brand-border); }
  @media (max-width: 24rem) {
    .sp__swatches { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sp__buttons li { grid-template-columns: 1fr; gap: 0.4rem; }
  }
</style>
