{
  "name": "docs-site",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The public docs and marketing site, built with the kit itself.",
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
