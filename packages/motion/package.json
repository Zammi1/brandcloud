{
  "name": "@brandcloud/motion",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "description": "Motion tokens, CSS utilities, View Transitions recipes, character presets and spring drivers for web and React Native. Reduced-motion safe.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "PRINCIPLES.md",
    "LICENSE",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./character": {
      "types": "./dist/character.d.ts",
      "import": "./dist/character.js"
    },
    "./character.css": {
      "types": "./dist/character.css.d.ts",
      "default": "./dist/character.css"
    },
    "./tokens.css": {
      "types": "./dist/tokens.css.d.ts",
      "default": "./dist/tokens.css"
    },
    "./utilities.css": {
      "types": "./dist/utilities.css.d.ts",
      "default": "./dist/utilities.css"
    },
    "./motion.css": {
      "types": "./dist/motion.css.d.ts",
      "default": "./dist/motion.css"
    },
    "./view-transitions.css": {
      "types": "./dist/view-transitions.css.d.ts",
      "default": "./dist/view-transitions.css"
    },
    "./tailwind.css": {
      "types": "./dist/tailwind.css.d.ts",
      "default": "./dist/tailwind.css"
    },
    "./tokens.json": "./dist/tokens.json",
    "./antipatterns.json": "./dist/antipatterns.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-css.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "pack:check": "pnpm pack --dry-run"
  },
  "peerDependencies": {
    "motion": "^12.0.0 || ^13.0.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.20.1",
    "@types/react": "catalog:",
    "jsdom": "^26.1.0",
    "motion": "^13.1.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zammi1/brandcloud.git",
    "directory": "packages/motion"
  },
  "engines": {
    "node": ">=22.12"
  }
}
