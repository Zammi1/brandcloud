---
/**
 * FAQ on native <details>/<summary>: works with no JavaScript, keyboard accessible.
 *   split    heading (and the "still have questions" aside) left, questions right (default)
 *   stacked  heading on top, questions below in a measured column
 * Answers are plain text (`answer`) or trusted, author-written HTML (`answerHtml`).
 * The aside slot (or `ask`) sits under the heading on wide screens and after the list on phones
 * (rendered once, placed by the grid).
 */
import "../styles/base.css";
import Heading from "./Heading.astro";
import Button from "./Button.astro";
import { slug } from "../lib/index.js";
import type { CtaLink, FaqItem } from "../copy-types.js";
interface Props {
  items: FaqItem[];
  heading?: string;
  intro?: string;
  variant?: "split" | "stacked";
  headingLevel?: "h2" | "h3";
  /** Open the first question. */
  openFirst?: boolean;
  /** "Still have questions?" block: heading, text and one action. */
  ask?: { heading: string; text?: string; action: CtaLink };
  id?: string;
  class?: string;
}
const { items, heading, intro, variant = "split", headingLevel = "h2", openFirst = false, ask, id, class: className } = Astro.props;
const titleId = id ? `${id}-title` : heading ? `ba-faq-${slug(heading)}` : undefined;
const hasAside = Boolean(ask) || Astro.slots.has("aside");
const A = headingLevel === "h2" ? "h3" : "h4";
---
<div id={id} class:list={["ba", "ba-faq", className]} data-variant={variant}>
  {(heading || intro) && (
    <div class="ba-faq__intro">
      {heading && <Heading as={headingLevel} id={titleId}>{heading}</Heading>}
      {intro && <p class="ba-lead">{intro}</p>}
    </div>
  )}
  <div class="ba-faq__list" aria-labelledby={titleId} role={titleId ? "group" : undefined}>
    {items.map((item, index) => (
      <details class="ba-faq__item" open={openFirst && index === 0 ? true : undefined} id={item.id}>
        <summary class="ba-faq__q"><span>{item.question}</span><span class="ba-faq__pm" aria-hidden="true"></span></summary>
        {item.answerHtml ? <div class="ba-faq__a" set:html={item.answerHtml} /> : <div class="ba-faq__a"><p>{item.answer}</p></div>}
      </details>
    ))}
  </div>
  {hasAside && (
    <div class="ba-faq__aside">
      <slot name="aside">
        {ask && (
          <>
            <A class="ba-faq__ask-title">{ask.heading}</A>
            {ask.text && <p class="ba-faq__ask-text">{ask.text}</p>}
            <Button href={ask.action.href} external={ask.action.external} channel={ask.action.channel} tone={ask.action.channel === "whatsapp" ? "whatsapp" : "ink"}>{ask.action.label}</Button>
          </>
        )}
      </slot>
    </div>
  )}
</div>

<style is:global>
@layer components {
  .ba-faq { display: grid; gap: clamp(2rem, 4vw, 3rem); }
  .ba-faq__intro { display: grid; gap: 1.25rem; align-content: start; max-width: 40rem; }
  .ba-faq__list { display: grid; align-content: start; border-top: 1px solid var(--brand-border); }
  .ba-faq__item { border-bottom: 1px solid var(--brand-border); }
  .ba-faq__q {
    display: flex; justify-content: space-between; align-items: baseline; gap: 1.5rem;
    padding: 1.375rem 0; cursor: pointer; list-style: none;
    font-family: var(--ba-font-display); font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3rem); font-weight: 500; line-height: 1.35; letter-spacing: -0.012em;
  }
  .ba-faq__q::-webkit-details-marker { display: none; }
  .ba-faq__pm { position: relative; flex: none; width: 0.875rem; height: 0.875rem; top: 0.0625rem; }
  .ba-faq__pm::before, .ba-faq__pm::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: currentColor; transform: translateY(-50%); transition: transform 0.2s ease; }
  .ba-faq__pm::after { transform: translateY(-50%) rotate(90deg); }
  .ba-faq__item[open] .ba-faq__pm::after { transform: translateY(-50%) rotate(0deg); }
  .ba-faq__a { display: grid; gap: 0.75rem; max-width: 40em; padding: 0 3.5rem 1.625rem 0; color: var(--brand-text-muted); line-height: 1.6; }
  .ba-faq__a p { margin: 0; }
  .ba-faq__a a { color: var(--ba-link); font-weight: 600; }
  .ba-faq__aside { display: grid; gap: 0.75rem; justify-items: start; }
  .ba-faq__ask-title { margin: 0; font-family: var(--ba-font-display); font-size: 1.375rem; font-weight: 600; line-height: 1.2; }
  .ba-faq__ask-text { margin: 0 0 0.5rem; color: var(--brand-text-muted); }
  @media (max-width: 37.4375rem) { .ba-faq__a { padding-right: 0; } }
  @media (prefers-reduced-motion: reduce) { .ba-faq__pm::before, .ba-faq__pm::after { transition: none; } }

  .ba-faq[data-variant="stacked"] .ba-faq__list { max-width: 52rem; }
  @media (min-width: 64rem) {
    .ba-faq[data-variant="split"] { grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); grid-template-rows: auto 1fr; column-gap: 5rem; row-gap: 2.5rem; align-items: start; }
    .ba-faq[data-variant="split"] .ba-faq__intro { grid-column: 1; grid-row: 1; }
    .ba-faq[data-variant="split"] .ba-faq__list { grid-column: 2; grid-row: 1 / span 2; }
    .ba-faq[data-variant="split"] .ba-faq__aside { grid-column: 1; grid-row: 2; }
  }
}
</style>
