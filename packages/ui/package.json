{
  "name": "@brandcloud/ui",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./experimental/annotated-action": {
      "types": "./dist/annotated-action.d.ts",
      "import": "./dist/annotated-action.js"
    },
    "./experimental/text-button": {
      "types": "./dist/text-button.d.ts",
      "import": "./dist/text-button.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "react-server": "./dist/card.js",
      "import": "./dist/card.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "import": "./dist/dialog.js"
    },
    "./drawer": {
      "types": "./dist/drawer.d.ts",
      "import": "./dist/drawer.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./meter": {
      "types": "./dist/meter.d.ts",
      "import": "./dist/meter.js"
    },
    "./menu": {
      "types": "./dist/menu.d.ts",
      "import": "./dist/menu.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "import": "./dist/popover.js"
    },
    "./experimental/polish": {
      "types": "./dist/polish.d.ts",
      "import": "./dist/polish.js"
    },
    "./react-node": {
      "types": "./dist/react-node.d.ts",
      "react-server": "./dist/react-node.js",
      "import": "./dist/react-node.js"
    },
    "./accordion": {
      "types": "./dist/accordion.d.ts",
      "import": "./dist/accordion.js"
    },
    "./avatar": {
      "types": "./dist/avatar.d.ts",
      "import": "./dist/avatar.js"
    },
    "./separator": {
      "types": "./dist/separator.d.ts",
      "import": "./dist/separator.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "import": "./dist/select.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./textarea": {
      "types": "./dist/textarea.d.ts",
      "import": "./dist/textarea.js"
    },
    "./form-field": {
      "types": "./dist/form-field.d.ts",
      "import": "./dist/form-field.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "import": "./dist/checkbox.js"
    },
    "./radio": {
      "types": "./dist/radio.d.ts",
      "import": "./dist/radio.js"
    },
    "./switch": {
      "types": "./dist/switch.d.ts",
      "import": "./dist/switch.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "import": "./dist/tooltip.js"
    },
    "./toast": {
      "types": "./dist/toast.d.ts",
      "import": "./dist/toast.js"
    },
    "./notice": {
      "types": "./dist/notice.d.ts",
      "import": "./dist/notice.js"
    },
    "./loading": {
      "types": "./dist/loading.d.ts",
      "import": "./dist/loading.js"
    },
    "./feedback-prompt": {
      "types": "./dist/feedback-prompt.d.ts",
      "import": "./dist/feedback-prompt.js"
    },
    "./page-header": {
      "types": "./dist/page-header.d.ts",
      "import": "./dist/page-header.js"
    },
    "./empty-state": {
      "types": "./dist/empty-state.d.ts",
      "import": "./dist/empty-state.js"
    },
    "./code-block": {
      "types": "./dist/code-block.d.ts",
      "import": "./dist/code-block.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./reset.css": {
      "types": "./dist/reset.css.d.ts",
      "default": "./dist/reset.css"
    },
    "./public.css": {
      "types": "./dist/public.css.d.ts",
      "default": "./dist/public.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "vite build && node ../../scripts/emit-css-source-maps.mjs --package=ui && node ../../scripts/emit-asset-declarations.mjs --package=ui && tsc --emitDeclarationOnly -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "BROWSER_TESTS=1 vitest run src/dialog-drawer.browser.test.ts"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^26.1.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "axe-core": "4.13.0"
  },
  "description": "Accessible React primitives for crafted, brandable interfaces, styled only with @brandcloud/tokens.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zammi1/brandcloud.git",
    "directory": "packages/ui"
  },
  "engines": {
    "node": ">=22.12"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "accessibility",
    "base-ui"
  ]
}
