{
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "https://brandui-web.vercel.app/app/"
    },
    {
      "source": "/app/(.*)",
      "destination": "https://brandui-web.vercel.app/app/$1"
    }
  ],
  "buildCommand": "pnpm build && pnpm docs:build",
  "outputDirectory": "apps/docs-site/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null
}
